# Banco de dados
# Desenvolvimento (SQLite):
DATABASE_URL="file:./dev.db"
# Produção (PostgreSQL) — troque também o provider em prisma/schema.prisma:
# DATABASE_URL="postgresql://usuario:senha@host:5432/ranchos?sslmode=require"

# NextAuth — gere com: npx auth secret  (ou openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-longo"
# Em produção na Vercel isto é detectado automaticamente
AUTH_TRUST_HOST=true

# Upload de imagens em produção (opcional). Sem isso, salva em public/uploads.
# BLOB_READ_WRITE_TOKEN=""
